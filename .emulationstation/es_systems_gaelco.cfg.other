<?xml version="1.0" encoding="UTF-8"?>
<!-- *** es_systems.cfg edited for RetroBat by Team PixN ***-->
<systemList>
  <system>
    <name>gaelco</name>
    <fullname>Gaelco</fullname>
    <manufacturer>Gabinete Electrónico Consultivo S.A.</manufacturer>
    <hardware>arcade</hardware>
    <path>~\..\roms\gaelco</path>
    <extension>.zip .wsquashfs</extension>
    <command>"%HOME%\emulatorLauncher.exe" -gameinfo %GAMEINFOXML% %CONTROLLERSCONFIG% -system %SYSTEM% -emulator %EMULATOR% -core %CORE% -rom %ROM%</command>
    <emulators>
      <emulator name="demul">
        <core>gaelco</core>
      </emulator>
      <emulator name="libretro">
        <cores>
          <core>mame</core>
          <core>mame2016</core>
          <core>mame2014</core>
        </cores>
      </emulator>
	  <emulator name="windows">
      </emulator>
    </emulators>
    <platform>gaelco, arcade</platform>
    <theme>gaelco</theme>
  </system>
